# ---------------------------------------------------------------------------
# Agente multimodal - variables de entorno
# Copia este fichero a .env y ajusta lo que necesites.
# NINGUNA de estas variables es obligatoria: los valores por defecto ya
# funcionan y el proyecto arranca sin cuenta en ningun servicio de pago.
# ---------------------------------------------------------------------------

# --- Modelos locales (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
TEXT_MODEL_NAME=qwen3:14b
ITT_MODEL_NAME=gemma3:4b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- Voz ---
STT_MODEL_NAME=small
TTS_VOICE=es_ES-davefx-medium

# --- Imagen ---
TTI_MODEL_NAME=stabilityai/sd-turbo
TTI_STEPS=1

# --- Base de datos ---
URI=postgresql+asyncpg://root:password@127.0.0.1:5432/agent

# --- Memoria ---
MEMORY_TOP_K=3
TOTAL_MESSAGES_SUMMARY_TRIGGER=20
TOTAL_MESSAGES_AFTER_SUMMARY=5
SIMILARITY_THRESHOLD=0.30

# --- Cache ---
CACHE_ENABLED=true
CACHE_TTL_MINUTES=60

# --- Observabilidad (OPCIONAL) ---
# Sin estas dos claves el agente funciona igual, simplemente no envia trazas.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
